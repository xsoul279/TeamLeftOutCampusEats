# Copy this file to .env and replace the placeholder values before starting Compose.
# Keep .env private; only this example belongs in version control.
POSTGRES_DB=campuseats
POSTGRES_USER=campuseats
POSTGRES_PASSWORD=replace-with-a-private-database-password

# Generate a key with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-key

# Leave empty to build the URL from POSTGRES_* using the Compose db service.
# For an external PostgreSQL database, set a URL and URL-encode its credentials.
DATABASE_URL=

# Web port on the host; change to 5001 if port 5000 is occupied.
WEB_PORT=5000
